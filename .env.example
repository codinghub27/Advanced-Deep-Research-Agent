# Copy to .env and fill in real values. NEVER commit .env or put real secrets here.

# --- Database (required) ---
# PostgreSQL (psycopg v3 driver):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME

# --- Auth (required) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-string
# Optional, defaults to HS256
ALGORITHM=HS256
# Optional. Comma-separated usernames allowed to call /admin/* endpoints.
# Unset/empty = nobody is admin (endpoints return 403). Register the admin
# account before setting this, otherwise anyone could register that username.
ADMIN_USERNAMES=

# --- LLM / search providers (required) ---
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key

# --- Official documentation source (optional; all three have safe defaults) ---
# Set to false/0/no/off to search the web only (kill switch).
OFFICIAL_DOCS_ENABLED=true
# Seconds to wait for the documentation search (1-60). A timeout never fails research.
OFFICIAL_DOCS_TIMEOUT_S=15
# Optional JSON file merged over the built-in registry (same "id" replaces an entry,
# new ids are added). Format: research_app/sources/official_docs/data/official_docs.json
# OFFICIAL_DOCS_REGISTRY_PATH=

# --- Source router: GitHub + Reddit (optional; both have safe defaults) ---
# Set to false/0/no/off to disable GitHub/Reddit and technology-problem documentation
# lookups. Web search and the Phase 4 documentation detection are unaffected.
SOURCE_ROUTER_ENABLED=true
# Seconds to wait for each GitHub / Reddit search (1-60). A timeout never fails research.
SOURCE_ROUTER_TIMEOUT_S=15

# --- Planner / source router (Phase 6; all optional, safe defaults) ---
# Most sources one sub-question is sent to (1-4). Official docs and web are never trimmed by it;
# Reddit, then GitHub, are. 3 = e.g. troubleshooting searches docs + GitHub + web.
MAX_SOURCES_PER_TASK=3
# Source searches in flight at once, across the whole process (1-20). Every Tavily call takes a slot.
CONCURRENCY_LIMIT=6

# --- Research pipeline (Phase 6; all optional) ---
# false skips the single gap-filling search round.
GAP_SEARCH_ENABLED=true
# Queries in the gap round, and in a critic retry (0-4).
MAX_TARGETED_QUERIES=2
# 0 disables the critic retry; 1 (the maximum) allows one.
MAX_CRITIC_RETRIES=1
# Share of a sub-question's key words a document must contain to count as evidence for it (0-1).
RELEVANCE_THRESHOLD=0.3

# --- Real-time research (optional) ---
# false turns off the Tavily date window (time_range) that "latest / recent / current / news"
# questions get. Today's date in the prompts and the past-year guard stay on.
RECENCY_FILTER_ENABLED=true

# --- Conversation (Phase 6; all optional) ---
# Earlier turns given to query understanding and the planner (1-50).
CONVERSATION_HISTORY_LIMIT=10
# Characters of an earlier ANSWER kept in that context; never the full answer (50-2000).
ANSWER_SUMMARY_LENGTH=300
# Auto-generated session title length (10-255).
SESSION_TITLE_MAX_LENGTH=80

# --- Logging (optional) ---
# DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=INFO
# false (default) hides the per-node / per-search / routing INFO lines and the GET /health access
# lines, leaving one line per research run plus all warnings and errors. true shows everything.
LOG_NODE_TRACE=false
