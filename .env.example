# Copy to .env and fill in real values. NEVER commit .env or put real secrets here.

# --- Database (required) ---
# PostgreSQL (psycopg v3 driver):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME

# --- Auth (required) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-string
# Optional, defaults to HS256
ALGORITHM=HS256
# Optional. Comma-separated usernames allowed to call /admin/* endpoints.
# Unset/empty = nobody is admin (endpoints return 403). Register the admin
# account before setting this, otherwise anyone could register that username.
ADMIN_USERNAMES=

# --- LLM / search providers (required) ---
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key

# --- Official documentation source (optional; all three have safe defaults) ---
# Set to false/0/no/off to search the web only (kill switch).
OFFICIAL_DOCS_ENABLED=true
# Seconds to wait for the documentation search (1-60). A timeout never fails research.
OFFICIAL_DOCS_TIMEOUT_S=15
# Optional JSON file merged over the built-in registry (same "id" replaces an entry,
# new ids are added). Format: research_app/sources/official_docs/data/official_docs.json
# OFFICIAL_DOCS_REGISTRY_PATH=

# --- Source router: GitHub + Reddit (optional; both have safe defaults) ---
# Set to false/0/no/off to disable GitHub/Reddit and technology-problem documentation
# lookups. Web search and the Phase 4 documentation detection are unaffected.
SOURCE_ROUTER_ENABLED=true
# Seconds to wait for each GitHub / Reddit search (1-60). A timeout never fails research.
SOURCE_ROUTER_TIMEOUT_S=15

# --- Logging (optional) ---
# DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=INFO
